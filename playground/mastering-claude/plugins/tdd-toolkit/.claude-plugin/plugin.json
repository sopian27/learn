{
    "name":"tdd-toolkit",
    "version":"1.1.0",
    "description":"Enforce observable RED-GREEN TDD loop before implementation claims",
    "author":{"name":"sopian"},
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/record-test-result.py\"" }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-red-first.py\"" }
                ]
            }
        ]
    }
}